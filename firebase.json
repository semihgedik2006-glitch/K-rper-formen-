{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },

  "//emulators": "Nur für die Regeltests unter tests/rules. Der Auth-Emulator wird gebraucht, weil firmaAnlegen ein echtes Anmeldekonto anlegt.",
  "emulators": {
    "firestore": { "port": 8791 },
    "auth": { "port": 9099 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  },

  "//hosting": "Ausgeliefert wird das Projektverzeichnis abzüglich der ignore-Liste. Alles, was nicht in den Browser gehört, muss dort stehen — sonst ist es öffentlich abrufbar.",
  "hosting": {
    "public": ".",
    "ignore": [
      "**/.*",
      "**/node_modules/**",
      "firebase.json",
      "firestore.rules",
      "storage.rules",
      "functions/**",
      "tests/**",
      "tools/**",
      "docs/**",
      "**/*.md",
      "**/*.txt",
      "**/*.sh",
      "**/*.gs",
      "**/*.py",
      "**/*.log"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "//": "index.html, sw.js und konfig.js nie zwischenspeichern. konfig.js entscheidet, welche Datenbank die App anfasst; eine alte Fassung im Zwischenspeicher ist schlimmer als eine langsame Ladezeit. Drei getrennte Einträge statt eines Musters — an dieser Stelle ist Wörtlichkeit mehr wert als Kürze.",
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/konfig.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "//": "Symbole ändern sich praktisch nie.",
        "source": "**/*.@(png|svg|jpg|jpeg|webp|ico)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800" }
        ]
      }
    ]
  }
}
