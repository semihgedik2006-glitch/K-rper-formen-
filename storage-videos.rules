rules_version = '2';

// ─────────────────────────────────────────────────────────────────────
// Firebase Storage – Regeln für den VIDEO-EIMER der Schulungen
//
// Vorbereitet am 24.9.2026, AUSGEROLLT seit dem 29.9.2026: an dem Tag
// wurde der Eimer `formenchat-schulungsvideos` angelegt. Aus dem Betrieb:
//   „Videos kommen noch speicher ort können wir vorbereiten so gut es
//    geht"
//
// Entschieden ist seit dem 22.9.2026: ein EIGENER, ZWEITER Eimer —
// niemals der mit der nächtlichen Sicherung (storage.rules, dort ist
// alles zu). Diese Datei gehört zu diesem zweiten Eimer; welcher Eimer
// welche Datei bekommt, steht in firebase.json (Ziele) und .firebaserc.
// Die Schritte stehen in docs/VIDEOS.md.
//
// Was hier gilt:
//   · Lesen: wer in DIESER Firma angemeldet und freigegeben ist.
//   · Auflisten: niemand. Wer ein Video sehen soll, bekommt es über das
//     Modul, nicht über ein Verzeichnis.
//   · Hochladen: nur die Leitung (Chef oder Studioleitung) der Firma,
//     nur Videodateien, höchstens 5 GB (siehe unten).
//   · Ersetzen: niemand — ein neues Video ist eine neue Datei.
//   · Löschen: die Leitung der Firma.
//   · Alles andere: zu.
//
// Und NIE: `allow read: if request.auth != null`. Registrieren kann
// sich in dieser App jeder selbst.
//
// WAS DAS NICHT SCHÜTZT, und das gehört gesagt: eine Download-Adresse
// mit Token (getDownloadURL) umgeht diese Regeln. Wer die Adresse eines
// Videos weitergibt, gibt das Video weiter. Für Schulungsvideos ist das
// vertretbar; für etwas Vertrauliches wäre es dieser Weg nicht.
// Geprüft in tests/rules/videos.test.js.
// ─────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {
    function profil() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function aktivIn(firma) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && profil().get('firma', 'koerperformen') == firma
        && profil().get('aktiv', true) != false;
    }
    function leitungIn(firma) {
      return aktivIn(firma) && (profil().role == 'chef' || profil().role == 'leiter');
    }

    match /firmen/{firma}/schulungen/{modul}/{datei} {
      allow get: if aktivIn(firma);
      allow list: if false;
      /* resource == null ausdrücklich: der Emulator hat ein Überschreiben
         als „create" durchgelassen (tests/rules/videos.test.js). Ob die
         Produktion das genauso tut, ist hier nicht prüfbar — die Zeile
         schadet dort nicht. */
      allow create: if leitungIn(firma)
        && resource == null
        && request.resource.contentType.matches('video/.*')
        /* Aus dem Betrieb, 29.9.2026: „ich würde die dateien größe auf 4gb
           erhöhen weil ein video halt auch 4gb groß ist". Die Grenze ist
           5 GiB, nicht 4: der Mac zählt 1 GB = 1.000.000.000 Byte, Windows
           zeigt 1.073.741.824 Byte als „GB" an. Ein Video, das dort als
           „4,2 GB" erscheint, soll nicht knapp daran scheitern. Dieselbe
           Zahl steht in index.html (VIDEO_GRENZE); test-video-hochladen
           prüft, dass beide übereinstimmen. */
        && request.resource.size <= 5 * 1024 * 1024 * 1024;
      allow update: if false;
      allow delete: if leitungIn(firma);
    }

    match /{alles=**} {
      allow read, write: if false;
    }
  }
}
