rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Hilfsfunktionen ──
    function signedIn() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isChef() {
      return hasProfile() && myProfile().role == 'chef';
    }
    // Studio-Leiter: wie ein Chef, aber nur in den eigenen Studios
    function isLeiter() {
      return hasProfile() && myProfile().role == 'leiter';
    }
    // Studios, die ich verwalten darf (als Kennungen, z. B. "studio-6")
    function myKeys() {
      return myProfile().get('studioKeys', []);
    }
    // Darf ich in DIESEM Studio verwalten?
    function manages(studioKey) {
      return isChef() || (isLeiter() && studioKey in myKeys());
    }

    // ── Benutzerprofile ──
    match /users/{uid} {
      allow read: if signedIn();
      // Wer sein EIGENES Profil anlegt, darf sich dabei nur "mitarbeiter"
      // geben. Vorher war jede Rolle erlaubt: der Chef-Code stand im
      // Quelltext der App, und die Regeln haben ihn nie geprüft – wer die
      // Seite ansah, konnte sich Vollzugriff auf alle 14 Studios geben.
      // Chef- und Leiter-Konten legt ab jetzt ausschliesslich ein Chef an.
      allow create: if isChef()
        || (request.auth.uid == uid
            && (!('role' in request.resource.data)
                || request.resource.data.role == 'mitarbeiter'));
      // Der Chef darf alles ändern. Alle anderen dürfen nur ihr eigenes Profil
      // bearbeiten und dabei NICHT Rolle oder Studio-Zuordnung anfassen –
      // sonst könnte sich jemand selbst zum Studio-Leiter machen.
      allow update: if isChef()
        || (request.auth.uid == uid
            && !request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(['role','studios','studio','studioKeys']));
      // nur der Chef kann einen Zugang entfernen
      allow delete: if isChef();
    }

    // Sprachnachrichten liegen als Datenblock in der Nachricht. Ein Dokument
    // darf 1 MB groß sein – wir begrenzen die Aufnahme auf 800 KB, damit
    // Text, Bild und Aufnahme zusammen sicher hineinpassen.
    function audioOk() {
      return !('audio' in request.resource.data)
        || (request.resource.data.audio is string
            && request.resource.data.audio.size() <= 800000);
    }

    // ── Chat-Nachrichten ──
    match /channels/{channelId}/messages/{msgId} {
      allow read: if signedIn();
      // Nur als man selbst senden; Bilder/Text/Aufnahme begrenzen
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && audioOk();
      // Reagieren darf jeder (nur das Feld reactions).
      // Den Text bearbeiten darf nur der Verfasser, und nur 15 Minuten lang.
      allow update: if signedIn() && (
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        || (resource.data.uid == request.auth.uid
            && request.time.toMillis() < resource.data.ts + 900000
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['text','editedAt','mentions']))
        // Anheften ist Sache der Verwaltung: was oben steht, sehen alle
        || (manages(channelId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned']))
      );
      // Chef darf jede Nachricht löschen; Mitarbeiter nur eigene innerhalb 1 Stunde
      allow delete: if isChef()
        || manages(channelId)
        || (signedIn()
            && resource.data.uid == request.auth.uid
            && request.time.toMillis() < resource.data.ts + 3600000);
    }

    // ── Aufgaben pro Studio ──
    match /studios/{studioKey}/todos/{todoId} {
      allow read: if signedIn();
      allow create: if manages(studioKey);   // Chef überall, Leiter in seinen Studios
      allow delete: if manages(studioKey);
      // Mitarbeiter dürfen abhaken / Foto anhängen (update erlaubt für Eingeloggte)
      allow update: if signedIn();
    }

    // ── Putzplan pro Studio (Reinigungsaufgaben) ──
    match /studios/{studioKey}/cleaning/{taskId} {
      allow read: if signedIn();
      allow create: if manages(studioKey);   // Chef überall, Leiter in seinen Studios
      allow delete: if manages(studioKey);
      allow update: if signedIn();                     // Mitarbeiter dürfen abhaken
    }

    // ── Putzplan-Notizen pro Studio (vom Team) ──
    match /studios/{studioKey}/cleaningNotes/{noteId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.byUid == request.auth.uid;
      // Chef darf jede Notiz löschen; Mitarbeiter nur eigene innerhalb 1 Stunde
      allow delete: if manages(studioKey)
        || (signedIn()
            && resource.data.byUid == request.auth.uid
            && request.time.toMillis() < resource.data.ts + 3600000);
      allow update: if false;
    }

    // ── Ankündigungen ──
    match /announcements/{annId} {
      allow read: if signedIn();
      // Chef an alle oder einzelne Studios; Leiter nur an seine Studios
      allow create: if request.resource.data.uid == request.auth.uid
        && (isChef()
            || (isLeiter() && request.resource.data.target in myKeys()));
      // Chef/zuständiger Leiter dürfen alles; alle anderen nur das Lesen markieren
      allow update: if isChef()
        || (isLeiter() && resource.data.target in myKeys())
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
      allow delete: if isChef()
        || (isLeiter() && resource.data.target in myKeys());
    }

    // ── Materialbestand pro Studio ──
    // Jeder Eingeloggte darf den Bestand lesen und eintragen.
    match /inventory/{studioKey} {
      allow read: if signedIn();
      // Eintragen dürfen alle Eingeloggten; das Soll-Limit setzt die Verwaltung
      allow write: if signedIn();
    }

    // ── Dokumente (Metadaten) ──
    match /documents/{docId} {
      allow read: if signedIn();
      // Leiter darf nur Dokumente anlegen, die ausschließlich seine Studios betreffen
      allow create: if isChef()
        || (isLeiter() && request.resource.data.studios.hasOnly(myKeys()));
      allow update, delete: if isChef()
        || (isLeiter() && resource.data.studios.hasOnly(myKeys()));
    }
    // ── Dokument-Inhalte (kleine Dateien direkt in der Datenbank, kostenlos) ──
    match /documentData/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isChef() || isLeiter();
    }

    // ── Konfiguration (z. B. Onboarding-Checkliste) ──
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isChef();
    }

    // ── Direktnachrichten (1:1) – nur die beiden Beteiligten ──
    // dmId hat die Form  dm_<uidA>_<uidB>
    match /dms/{dmId} {
      // Lesen/Abfragen über das participants-Feld (funktioniert auch für Listen-Abfragen)
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
    }
    match /dms/{dmId}/messages/{msgId} {
      allow read: if signedIn() && dmId.split('_').hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && dmId.split('_').hasAny([request.auth.uid])
        && audioOk();
      // Update nur für Beteiligte (z. B. Checklisten-Häkchen)
      allow update: if signedIn() && dmId.split('_').hasAny([request.auth.uid]);
      allow delete: if signedIn() && dmId.split('_').hasAny([request.auth.uid])
        && (isChef()
            || (resource.data.uid == request.auth.uid
                && request.time.toMillis() < resource.data.ts + 3600000));
    }

    // ── Marketing-App (marketing.html): Kampagnen-Projekte mit Versionen ──
    // Jeder Eingeloggte darf lesen und Projekte anlegen/pflegen.
    // Löschen: nur Chef oder wer das Projekt bzw. die Version angelegt hat.
    match /mkProjects/{projectId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn();
      allow delete: if isChef()
        || (signedIn() && resource.data.createdBy == request.auth.uid);

      match /versions/{versionId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.createdBy == request.auth.uid;
        // Versionen sind unveränderlich (Historie bleibt echt)
        allow update: if false;
        allow delete: if isChef()
          || (signedIn() && resource.data.createdBy == request.auth.uid);
      }
    }

    // ── Wachstum & Betrieb (wachstum.html) ──

    // Termine: jeder Eingeloggte darf lesen/anlegen/pflegen (gleiches Muster
    // wie Aufgaben; die Studio-Zuordnung filtert die App). Löschen: Chef
    // oder wer den Termin angelegt hat.
    match /appointments/{apptId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() <= 200
        && request.resource.data.startsAt is number;
      allow update: if signedIn();
      allow delete: if isChef()
        || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    // E-Mail-Vorlagen (Bestätigung/Erinnerung/Follow-up/Storno):
    // nur der Chef pflegt sie; die Server-Funktion liest per Admin-Rechten.
    match /emailTemplates/{tplId} {
      allow read, write: if isChef();
    }

    // Kennzahlen je Studio (Mitglieder, Auslastung, Miete …): nur Chef.
    match /studioMetrics/{studioKey} {
      allow read, write: if isChef();
    }

    // Wettbewerbsbeobachtung: nur Chef.
    match /competitors/{compId} {
      allow read, write: if isChef();
    }

    // Expansionsplanung (mögliche neue Standorte): nur Chef.
    match /expansionLeads/{leadId} {
      allow read, write: if isChef();
    }

    // ── Schichtplan pro Studio ──
    match /studios/{studioKey}/shifts/{shiftId} {
      allow read: if signedIn();
      // Einteilen darf nur die Verwaltung (Chef bzw. zuständiger Leiter)
      allow create, update, delete: if manages(studioKey);
    }

    // ── Abwesenheiten (Urlaub / Krank / Frei) ──
    match /studios/{studioKey}/absences/{absId} {
      allow read: if signedIn();
      // Jeder meldet sich selbst; die Verwaltung darf auch für andere eintragen
      allow create: if signedIn()
        && (request.resource.data.uid == request.auth.uid || manages(studioKey))
        // Wer für sich selbst einträgt, darf sich nicht gleich selbst
        // genehmigen. Krankmeldungen und Einträge der Verwaltung schon.
        && (manages(studioKey)
            || request.resource.data.type == 'krank'
            || request.resource.data.status == 'offen');
      // Genehmigen und Ablehnen ist Sache der Verwaltung
      allow update: if manages(studioKey);
      allow delete: if manages(studioKey)
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ── Übergabe-Notizen zwischen Schichten ──
    match /studios/{studioKey}/handovers/{hoId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if manages(studioKey)
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ── Schwarzes Brett (für alle Studios gemeinsam) ──
    match /board/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isChef()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ── Papierkorb ──
    // Gelöschtes liegt hier 30 Tage. Hineinlegen darf jeder Eingeloggte –
    // wer den Eintrag löschen durfte, darf ihn auch sichern. Ansehen,
    // zurückholen und endgültig entfernen ist Sache der Verwaltung.
    // Der Studio-Leiter sieht nur Einträge aus seinen Studios; Einträge
    // ohne Studio-Bezug (Infos, Dokumente, Brett) bleiben Chef-Sache.
    match /trash/{trashId} {
      allow read: if isChef()
        || (isLeiter() && resource.data.sk != null && manages(resource.data.sk));
      allow create: if signedIn()
        && request.resource.data.deletedByUid == request.auth.uid;
      allow update: if false;                    // Papierkorb wird nicht bearbeitet
      allow delete: if isChef()
        || (isLeiter() && resource.data.sk != null && manages(resource.data.sk));
    }

    // ── Wochen-Sicherungen (Material + Putzplan als Excel) – nur Chef ──
    match /archives/{weekId} {
      allow read, write: if isChef();
    }

    // ── Push-Tokens (für Benachrichtigungen) ──
    // Die Server-Funktion liest sie per Admin-Rechten; Clients schreiben nur ihren eigenen.
    match /pushTokens/{token} {
      allow read: if false;
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
