rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Hilfsfunktionen ──
    function signedIn() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isChef() {
      return hasProfile() && myProfile().role == 'chef';
    }
    // Studio-Leiter: wie ein Chef, aber nur in den eigenen Studios
    function isLeiter() {
      return hasProfile() && myProfile().role == 'leiter';
    }
    // Studios, die ich verwalten darf (als Kennungen, z. B. "studio-6")
    function myKeys() {
      return myProfile().get('studioKeys', []);
    }
    // Darf ich in DIESEM Studio verwalten?
    function manages(studioKey) {
      return isChef() || (isLeiter() && studioKey in myKeys());
    }

    // ─────────────────────────────────────────────────────────────────
    // BEITRITT: Firmencode + Freigabe durch den Chef
    //
    // Vorher genuegte "eingeloggt", und registrieren konnte sich jeder
    // selbst. Wer die Adresse der App kannte, legte sich ein Konto an und
    // las Teamchat, Personenliste, Aufgaben und Dokumente.
    //
    // Zwei Schranken, die getrennt wirken:
    //   1. Der Firmencode haelt Fremde davon ab, ueberhaupt ein Konto
    //      anzulegen. Er steht in config/registrierung – fuer Clients
    //      NICHT lesbar. get() innerhalb einer Regel unterliegt den
    //      Regeln nicht, der Vergleich funktioniert trotzdem.
    //   2. Die Freigabe: ein selbst angelegtes Konto startet mit
    //      aktiv:false und sieht nichts ausser dem eigenen Profil, bis
    //      ein Chef es freischaltet. Das faengt auch den Fall ab, dass
    //      der Code die Runde macht – etwa bei einem Ex-Mitarbeiter.
    //
    // SICHERUNG GEGEN AUSSPERREN: beide Schranken sind aus, solange sie
    // nicht ausdruecklich eingeschaltet werden. Fehlt config/registrierung
    // oder ist der Code leer, wird kein Code verlangt. Und ein Profil OHNE
    // das Feld aktiv gilt als aktiv – alle bestehenden Konten laufen
    // unveraendert weiter.
    // ─────────────────────────────────────────────────────────────────
    function beitrittConf() {
      return get(/databases/$(database)/documents/config/registrierung).data;
    }
    function confDa() {
      return exists(/databases/$(database)/documents/config/registrierung);
    }
    function codePflicht() {
      return confDa() && beitrittConf().get('code', '') != '';
    }
    function codeStimmt(uid) {
      return !codePflicht()
        || (exists(/databases/$(database)/documents/beitritt/$(uid))
            && get(/databases/$(database)/documents/beitritt/$(uid)).data.code
               == beitrittConf().code);
    }
    function freigabePflicht() {
      return confDa() && beitrittConf().get('freigabe', false) == true;
    }
    // Ein Konto ist aktiv, solange nicht ausdruecklich das Gegenteil
    // dransteht. Bestehende Profile haben das Feld nicht.
    function istAktiv() {
      return hasProfile() && myProfile().get('aktiv', true) == true;
    }

    // ─────────────────────────────────────────────────────────────────
    // MEHRERE FIRMEN (Stufe 2B aus MANDANT-PLAN.md)
    //
    // Die Regeln unten gibt es ZWEIMAL: einmal flach, wie bisher, und
    // einmal unter /firmen/{f}/. Das ist waehrend der Umstellung noetig -
    // die Daten ziehen erst in Stufe C um, und bis dahin muessen beide
    // Wege gelten. Danach faellt der flache Satz weg.
    //
    // DIE FALLE, die hier schon zweimal zugeschnappt ist: in Firestore
    // gilt JEDE zutreffende Regel, und EINE die erlaubt genuegt. Eine
    // breite Regel auf /firmen/{f}/{rest=**} wuerde deshalb alle
    // feineren darunter aushebeln - der Mitarbeiter duerfte ploetzlich
    // Rollen aendern. Die Firmen-Pruefung steht darum in JEDEM einzelnen
    // allow, nicht einmal oben. Erzeugt wurde das maschinell, geprueft
    // wird es von den Kreuztests in tests/rules/security.test.js.
    function meineFirma() {
      return hasProfile() ? myProfile().get('firma', '') : '';
    }
    // Gehoere ich zu DIESER Firma und ist mein Konto freigegeben?
    // Ein Konto ohne Feld 'firma' gehoert zur Voreinstellung - sonst
    // stuende der bestehende Betrieb nach dem Umschalten draussen.
    // Gehoert das Konto, das hier bearbeitet wird, zu MEINER Firma?
    // Solange es nur eine gibt, haben beide Seiten kein Feld 'firma' und
    // die Antwort ist ja - der heutige Betrieb merkt nichts.
    // Ein Chef ist niemand, den ein anderer Chef mal eben absetzt.
    // Bisher konnte jeder Chef jedem anderen die Rechte entziehen — bei
    // einem Streit zwischen Geschaeftsfuehrern waere das ein Wettrennen,
    // und der Schnellere gewinnt. Wer einen Chef herabstufen oder
    // entfernen will, braucht die Ebene darueber (Admin).
    // Das EIGENE Konto bleibt aendernbar, sonst kaeme man an sein
    // Profilbild nicht mehr heran.
    function fremderChef(uid) {
      return resource != null
        && resource.data.get('role', '') == 'chef'
        && request.auth.uid != uid;
    }
    /* Admin ist ein EIGENES Feld, keine Rolle.
       Waere es ein Rollenwert, muesste man sich zwischen "Chef meiner
       Firma" und "Betreiber ueber allen" entscheiden — wer sein
       bestehendes Konto hochstuft, verloere damit den Zugang zur eigenen
       Firma. Als Zusatzfeld bleibt role:'chef' bestehen und admin:true
       kommt daneben. */
    function istAdminKonto() {
      return hasProfile() && myProfile().get('admin', false) == true;
    }
    function gleicheFirma() {
      return resource == null
        || resource.data.get('firma', '') == meineFirma();
    }
    // Laeuft diese Firma noch? Der Betreiber kann sie sperren, und
    // beim Loeschen verschwindet ihr Dokument ganz (die Daten darunter
    // bleiben liegen - siehe firmaLoeschen in functions/index.js).
    //
    // WARUM DAS HIER STEHEN MUSS: bis zum 11.8.2026 sah die Sperre
    // niemand ausser den Zeitplaenen. Weder Regeln noch App haben je in
    // dieses Dokument geschaut. Im Bestaetigungsfenster stand
    // "Niemand aus diesem Betrieb kommt danach mehr hinein" - und das
    // war schlicht nicht wahr. Der Knopf war Deko.
    //
    // Ein get() je Auswertung kostet einen Lesevorgang. Das ist der
    // Preis dafuer, dass die Grenze wirklich eine ist.
    function firmaLaeuft(f) {
      return exists(/databases/$(database)/documents/firmen/$(f))
        && get(/databases/$(database)/documents/firmen/$(f)).data.get('aktiv', true) == true;
    }
    function inFirma(f) {
      return istAktiv()
        && firmaLaeuft(f)
        && (meineFirma() == f || (meineFirma() == '' && f == 'koerperformen'));
    }

    // Hat diese Firma Premium? (Stufe B aus ABO-PLAN.md)
    //
    // KEIN Abo hinterlegt = alles offen. Das ist der heutige Zustand
    // fuer den eigenen Betrieb und fuer jeden Kunden, bei dem noch
    // nichts eingetragen ist. Ein Kunde, dem die Haelfte fehlt, weil
    // jemand ein Feld nicht ausgefuellt hat, waere der schlechtere
    // Fehler — und er faellt erst auf, wenn er anruft.
    //
    // Diese Funktion steht ABSICHTLICH nicht in inFirma(): sie wird nur
    // dort gebraucht, wo eine Stufe wirklich etwas abgrenzt. In jedem
    // allow zu stehen hiesse ein get() bei jedem Zugriff, fuer eine
    // Grenze, die nur zwei Sammlungen betrifft.
    function hatPremium(f) {
      return !exists(/databases/$(database)/documents/firmen/$(f)/abo/aktuell)
        || get(/databases/$(database)/documents/firmen/$(f)/abo/aktuell)
             .data.get('stufe', 'premium') != 'basic';
    }

    // ── Benutzerprofile ──
    match /users/{uid} {
      /* ── DAS LOCH VOM 12.8.2026, geschlossen am selben Tag ──
         Hier stand: allow read: if istAktiv() || (eigenes Profil).
         OHNE FIRMENPRUEFUNG. users ist die einzige Sammlung, die NICHT
         unter /firmen/{f}/ liegt — und beim Schreiben stand die Pruefung
         (gleicheFirma), beim Lesen nicht.

         Gemessen im Emulator, bevor es repariert wurde: ein Mitarbeiter
         von Alpha las das Konto des Chefs von Beta samt E-Mail-Adresse
         und Geburtsdatum, und konnte die GANZE Sammlung auflisten. Die
         App tat das sogar von selbst: listenAllUsers() horchte auf
         db.collection('users') ohne Filter.

         Das EIGENE Profil bleibt immer lesbar, sonst kann die App einem
         wartenden Konto nicht einmal sagen, dass es wartet. Der
         Betreiber steht darueber, sonst kaeme er an seine eigene
         Kundenverwaltung nicht mehr heran.

         WER HIER ETWAS AENDERT, muss wissen: Firestore prueft Abfragen
         im VORAUS, nicht Dokument fuer Dokument. Eine ungefilterte
         Abfrage auf users wird deshalb abgelehnt — die App MUSS
         where('firma','==',…) mitgeben (listenAllUsers), und jedes
         Konto braucht das Feld. Nachgetragen wurde es am 12.8.2026
         ueber Verwaltung → Firmen → "Konten ohne Firma":
         8 Konten, 7 mit koerperformen, 1 andere Firma, 0 ohne Feld. */
      allow read: if istAdminKonto()
        || (signedIn() && request.auth.uid == uid)
        || (istAktiv() && gleicheFirma());
      // Wer sein EIGENES Profil anlegt, darf sich dabei nur "mitarbeiter"
      // geben. Vorher war jede Rolle erlaubt: der Chef-Code stand im
      // Quelltext der App, und die Regeln haben ihn nie geprüft – wer die
      // Seite ansah, konnte sich Vollzugriff auf alle 14 Studios geben.
      // Chef- und Leiter-Konten legt ab jetzt ausschliesslich ein Chef an.
      allow create: if isChef()
        || (request.auth.uid == uid
            && (!('role' in request.resource.data)
                || request.resource.data.role == 'mitarbeiter')
            && codeStimmt(uid)
            // Wenn die Freigabe eingeschaltet ist, startet das Konto
            // inaktiv. Sich selbst aktiv zu setzen waere sonst trivial.
            && (!freigabePflicht()
                || request.resource.data.get('aktiv', true) == false));
      // Der Chef darf alles ändern. Alle anderen dürfen nur ihr eigenes Profil
      // bearbeiten und dabei NICHT Rolle oder Studio-Zuordnung anfassen –
      // sonst könnte sich jemand selbst zum Studio-Leiter machen.
      // 'firma' gehoert in dieselbe Sperrliste wie 'role': wer sein
      // eigenes Firmenfeld aendern koennte, wechselt damit in einen
      // fremden Betrieb und liest dort alles. Von den Kreuztests
      // gefunden, nicht beim Durchlesen.
      // Das Feld 'admin' vergibt NUR ein Admin. Sonst koennte sich jeder
      // Chef zum Betreiber ueber alle Firmen machen — und die Trennung,
      // die 21 Kreuztests absichern, waere von innen aufgemacht.
      allow update: if istAdminKonto()
        || (isChef() && gleicheFirma() && !fremderChef(uid)
            && !request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(['admin']))
        || (request.auth.uid == uid
            && !request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(['role','studios','studio','studioKeys','aktiv','firma','admin']));
      // nur der Chef kann einen Zugang entfernen - und nur in der
      // eigenen Firma. Sonst koennte der Chef von A das Team von B
      // umschreiben oder loeschen; users liegt ja gemeinsam oben.
      allow delete: if istAdminKonto()
        || (isChef() && gleicheFirma() && !fremderChef(uid));
    }

    // ── Beitritts-Nachweis ──
    // Hier legt ein neues Konto EINMAL den eingegebenen Firmencode ab.
    // Warum nicht direkt ins Profil? users ist fuer alle Aktiven lesbar -
    // der Code stuende dann in einem Dokument, das jeder Kollege oeffnen
    // kann. Hier liest ihn niemand: nur die Regel oben vergleicht ihn,
    // und get() in einer Regel unterliegt den Regeln nicht.
    match /beitritt/{uid} {
      allow read: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 100;
      allow update, delete: if isChef();
    }

    // ── Einstellungen zum Beitritt ──
    // Der CODE. Nur der Chef sieht und aendert ihn. Die Regel fuer
    // users/{uid} vergleicht ihn per get() - das unterliegt den Regeln
    // nicht und funktioniert deshalb trotzdem.
    match /config/registrierung {
      allow read, write: if isChef();
    }
    // Die SCHALTER: "wird ein Code verlangt" und "muss freigegeben
    // werden". Bewusst fuer jeden lesbar, auch ohne Anmeldung - das
    // Registrierungsformular muss vor dem Login wissen, ob es das
    // Codefeld zeigen soll. Zwei Ja/Nein-Angaben verraten nichts; der
    // Code selbst steht hier nicht drin.
    match /config/beitrittSchalter {
      allow read: if true;
      allow write: if isChef();
    }

    // Die Studioliste. Ebenfalls fuer jeden lesbar, auch ohne Anmeldung:
    // im Registrierungsformular kreuzt man seine Studios an, und das ist
    // vor dem Login. Was hier drinsteht, sind die Standortnamen - die
    // stehen auch auf der Webseite des Betriebs. Kein Personenbezug,
    // keine Zahlen, keine Inhalte.
    //
    // Schreiben darf nur der Chef, und die Liste darf nur WACHSEN: die
    // Datenbank-Kennung eines Studios haengt an seinem Platz in dieser
    // Liste. Wer kuerzt oder umsortiert, ordnet alle bestehenden
    // Aufgaben, Schichten und Nachrichten einem anderen Studio zu -
    // lautlos. Die Regel laesst deshalb keine kuerzere Liste zu.
    match /config/studios {
      allow read: if true;
      allow create: if isChef();
      allow update: if isChef()
        && request.resource.data.liste.size() >= resource.data.liste.size();
      allow delete: if false;
    }

    // ── Impressum und Datenschutz (config/recht) ──
    //
    // Standen bis zum 11.8.2026 in konfig.js und galten damit fuer das
    // ganze Projekt. Seit mehrere Firmen in EINER Datenbank liegen, ist
    // das falsch: impressumspflichtig ist jeder Betreiber selbst.
    //
    // Lesen: jeder Angemeldete. Ausdruecklich auch, wer noch auf seine
    // Freigabe wartet (aktiv:false) - der sieht sonst als Einziger kein
    // Impressum. Was hier drinsteht, ist ohnehin fuer die Oeffentlichkeit
    // bestimmt: Name, Anschrift, Telefon, E-Mail des Betriebs.
    // Schreiben: nur der Chef. Wer das Impressum aendern kann, aendert,
    // wer fuer diese App haftet.
    //
    // WAS DURCH DIE ALLGEMEINE REGEL /config/{doc} SCHON GILT und was
    // diese hier daran aendert - denn in Firestore gilt JEDE zutreffende
    // Regel, und EINE die erlaubt genuegt:
    //   read   dort: istAktiv()  →  hier: true. Diese Regel WEITET
    //          also, sie schraenkt nicht ein. Genau deshalb ist sie
    //          ueberhaupt noetig; eine engere Regel waere Dekoration, die
    //          allgemeine wuerde sie ueberstimmen.
    //   write  dort: isChef()    →  hier: isChef(). Identisch, also kein
    //          Loch - aber auch keine zusaetzliche Sperre. Wer 'recht'
    //          jemals enger schuetzen will als den Rest von config, muss
    //          es DORT ausnehmen (wie bei 'studios' und 'registrierung'
    //          geschehen), nicht hier.
    //
    // WARUM OHNE ANMELDUNG LESBAR: ein Impressum hinter einem Login ist
    // keins - so steht es seit jeher im Quelltext der App, und § 5 DDG
    // verlangt "leicht erkennbar, unmittelbar erreichbar". Der Inhalt
    // ist per Definition fuer die Oeffentlichkeit bestimmt: Name,
    // Anschrift, Vertretung, Telefon, E-Mail. Genau dieselbe Ueberlegung
    // wie bei config/studios und config/beitrittSchalter weiter oben.
    match /config/recht {
      allow read: if true;
      allow write: if isChef();
    }

    // Sprachnachrichten liegen als Datenblock in der Nachricht. Ein Dokument
    // darf 1 MB groß sein – wir begrenzen die Aufnahme auf 800 KB, damit
    // Text, Bild und Aufnahme zusammen sicher hineinpassen.
    function audioOk() {
      return !('audio' in request.resource.data)
        || (request.resource.data.audio is string
            && request.resource.data.audio.size() <= 800000);
    }

    // ── Chat-Nachrichten ──
    match /channels/{channelId}/messages/{msgId} {
      allow read: if istAktiv();
      // Nur als man selbst senden; Bilder/Text/Aufnahme begrenzen
      allow create: if istAktiv()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && audioOk();
      // Reagieren darf jeder (nur das Feld reactions).
      // Den Text bearbeiten darf nur der Verfasser, und nur 15 Minuten lang.
      allow update: if istAktiv() && (
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        // Bei einer Umfrage abstimmen darf jeder – aber wirklich nur das
        // Stimmenfeld anfassen, nicht Frage oder Antworten.
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        || (resource.data.uid == request.auth.uid
            && request.time.toMillis() < resource.data.ts + 900000
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['text','editedAt','mentions']))
        // Anheften ist Sache der Verwaltung: was oben steht, sehen alle
        || (manages(channelId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned']))
      );
      // Chef darf jede Nachricht löschen; Mitarbeiter nur eigene innerhalb 1 Stunde
      allow delete: if isChef()
        || manages(channelId)
        || (istAktiv()
            && resource.data.uid == request.auth.uid
            && request.time.toMillis() < resource.data.ts + 3600000);
    }

    // ── Aufgaben pro Studio ──
    match /studios/{studioKey}/todos/{todoId} {
      allow read: if istAktiv();
      allow create: if manages(studioKey);   // Chef überall, Leiter in seinen Studios
      allow delete: if manages(studioKey);
      // Mitarbeiter dürfen abhaken / Foto anhängen (update erlaubt für Eingeloggte)
      allow update: if istAktiv();
    }

    // ── Putzplan pro Studio (Reinigungsaufgaben) ──
    match /studios/{studioKey}/cleaning/{taskId} {
      allow read: if istAktiv();
      allow create: if manages(studioKey);   // Chef überall, Leiter in seinen Studios
      allow delete: if manages(studioKey);
      allow update: if istAktiv();                     // Mitarbeiter dürfen abhaken
    }

    // ── Putzplan-Notizen pro Studio (vom Team) ──
    match /studios/{studioKey}/cleaningNotes/{noteId} {
      allow read: if istAktiv();
      allow create: if istAktiv()
        && request.resource.data.byUid == request.auth.uid;
      // Chef darf jede Notiz löschen; Mitarbeiter nur eigene innerhalb 1 Stunde
      allow delete: if manages(studioKey)
        || (istAktiv()
            && resource.data.byUid == request.auth.uid
            && request.time.toMillis() < resource.data.ts + 3600000);
      allow update: if false;
    }

    // ── Geräte pro Studio ──
    // Aufnehmen und entfernen ist Sache der Verwaltung. Den Status ändern
    // darf jeder Eingeloggte: einen Defekt melden können muss die Person,
    // die vor dem Gerät steht – nicht die, die gerade Dienst hat.
    match /studios/{studioKey}/devices/{devId} {
      allow read: if istAktiv();
      allow create: if manages(studioKey)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      allow delete: if manages(studioKey);
      // Umbenennen und umziehen darf nur die Verwaltung. Alle anderen
      // dürfen ausschliesslich den Zustand melden – sonst könnte eine
      // Meldung nebenbei das Gerät umbenennen.
      allow update: if manages(studioKey)
        || (istAktiv()
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['status','lastNote','lastBy','lastAt']));
    }

    // ── Verlauf zu den Geräten ──
    // Bewusst nicht änderbar und nicht löschbar (ausser durch die
    // Verwaltung): der Verlauf ist nur etwas wert, wenn er vollständig ist.
    function devPhotoOk() {
      return !('photo' in request.resource.data)
        || (request.resource.data.photo is string
            && request.resource.data.photo.size() <= 400000);
    }
    match /studios/{studioKey}/deviceLog/{logId} {
      allow read: if istAktiv();
      allow create: if istAktiv()
        && request.resource.data.byUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 300
        && devPhotoOk();
      allow update: if false;
      allow delete: if manages(studioKey);
    }

    // ── Ankündigungen ──
    match /announcements/{annId} {
      allow read: if istAktiv();
      // Chef an alle oder einzelne Studios; Leiter nur an seine Studios
      allow create: if request.resource.data.uid == request.auth.uid
        && (isChef()
            || (isLeiter() && request.resource.data.target in myKeys()));
      // Chef/zuständiger Leiter dürfen alles; alle anderen nur das Lesen markieren
      allow update: if isChef()
        || (isLeiter() && resource.data.target in myKeys())
        || (istAktiv() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
      allow delete: if isChef()
        || (isLeiter() && resource.data.target in myKeys());
    }

    // ── Materialbestand pro Studio ──
    // Jeder Eingeloggte darf den Bestand lesen und eintragen.
    match /inventory/{studioKey} {
      allow read: if istAktiv();
      // Eintragen dürfen alle Eingeloggten; das Soll-Limit setzt die Verwaltung
      allow write: if istAktiv();
    }

    // ── Dokumente (Metadaten) ──
    match /documents/{docId} {
      allow read: if istAktiv();
      // Leiter darf nur Dokumente anlegen, die ausschließlich seine Studios betreffen
      allow create: if isChef()
        || (isLeiter() && request.resource.data.studios.hasOnly(myKeys()));
      allow update, delete: if isChef()
        || (isLeiter() && resource.data.studios.hasOnly(myKeys()));
    }
    // ── Dokument-Inhalte (kleine Dateien direkt in der Datenbank, kostenlos) ──
    // Hier stand "isChef() || isLeiter()" - ohne Studio-Bezug. Ein Leiter
    // konnte die Metadaten eines fremden Dokuments nicht anfassen, den
    // INHALT aber ueberschreiben. Belegt durch tests/rules/security.test.js.
    // Jetzt gilt dieselbe Schranke wie fuer die Metadaten. Loeschen ist
    // Chefsache: Dokumente landen ohne Studio-Kennung im Papierkorb, und
    // den darf ohnehin nur der Chef endgueltig leeren.
    match /documentData/{docId} {
      allow read: if istAktiv();
      allow create, update: if isChef()
        || (isLeiter()
            && exists(/databases/$(database)/documents/documents/$(docId))
            && get(/databases/$(database)/documents/documents/$(docId))
                 .data.studios.hasOnly(myKeys()));
      allow delete: if isChef();
    }

    // ── Nachweise (Erste Hilfe, Trainerlizenz, EMS-Einweisung) ──
    // Qualifikationsdaten sind heikler als Putzplaene. Deshalb sehen sie
    // NUR die betroffene Person und der Chef - die Studio-Leitung
    // ausdruecklich nicht. Eintragen darf allein der Chef; er hat die
    // Unterlagen und haftet dafuer, dass sie stimmen.
    /* ── Nachweise ───────────────────────────────────────────────────
       Bis zum 12.8.2026 durfte sie nur der Chef eintragen. Bei 57 Leuten
       ist das Abtippen von Erste-Hilfe-Scheinen und Lizenzen sein
       Problem, nicht ihres — also wird es nicht gemacht, und die Liste
       ist nach einem halben Jahr wertlos.

       Jetzt trägt jeder seine eigenen ein. Drei Grenzen, die dabei
       wichtig sind, weil ein Erste-Hilfe-Nachweis rechtlich zählt:

         1. NUR DIE EIGENEN. uid muss die eigene sein — beim Anlegen und
            beim Ändern. Ohne die zweite Prüfung könnte man einen
            fremden Nachweis auf sich selbst umschreiben.
         2. LÖSCHEN DARF NUR DER CHEF. Wer seinen abgelaufenen Nachweis
            selbst entfernen kann, lässt ihn aus der Liste „läuft bald
            ab" verschwinden — und genau die ist der Zweck der Sache.
         3. „BESTÄTIGT" SETZT NUR DER CHEF. Selbst eingetragen heisst
            behauptet, nicht belegt. Der Unterschied muss sichtbar
            bleiben, sonst ist die Selbsteintragung ein Freibrief.

       erfasstVonUid muss beim MITARBEITER der eigene sein. Damit kann er
       einen selbst eingetragenen Nachweis nicht als vom Chef erfasst
       ausgeben — „selbst eingetragen" ist dadurch eine Tatsache und
       keine Behauptung des Clients.

       Vom Chef wird das Feld NICHT verlangt. Ein Pflichtfeld beim
       Schreiben bricht jede aeltere Fassung der App, die noch im
       Zwischenspeicher eines Geraets liegt — und die App ist eine PWA,
       da liegt immer eine. Fehlt das Feld, gilt der Eintrag als vom
       Chef erfasst, und genau das ist er dann auch. */
    match /certificates/{certId} {
      allow read: if isChef()
        || (istAktiv() && resource.data.uid == request.auth.uid);
      allow create: if isChef()
        || (istAktiv()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.erfasstVonUid == request.auth.uid
            && request.resource.data.get('bestaetigt', false) == false);
      /* Bis zur Bestaetigung darf man den eigenen Eintrag korrigieren —
         ein Zahlendreher im Datum soll kein Fall fuer den Chef sein.
         DANACH NICHT MEHR: sonst laesst sich ein bestaetigter
         Erste-Hilfe-Schein still um zwei Jahre verlaengern, und die
         Bestaetigung waere wertlos. Genau dieses Loch stand hier im
         ersten Entwurf. */
      allow update: if isChef()
        || (istAktiv()
            && resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && resource.data.get('bestaetigt', false) == false
            && request.resource.data.get('bestaetigt', false) == false);
      allow delete: if isChef();
    }

    // ── Konfiguration (z. B. Onboarding-Checkliste) ──
    match /config/{doc} {
      // registrierung ist ausdruecklich ausgenommen: In Firestore gilt
      // JEDE zutreffende Regel, nicht die speziellste. Ohne diese
      // Ausnahme wuerde die allgemeine Regel hier den Firmencode fuer
      // jeden Eingeloggten lesbar machen - und die Sperre waere
      // Dekoration.
      allow read: if istAktiv() && doc != 'registrierung'
                   && doc != 'beitrittSchalter' && doc != 'studios';
      // 'studios' muss auch beim SCHREIBEN ausgenommen sein, nicht nur
      // beim Lesen. Sonst haengt die Sperre "die Liste darf nur wachsen"
      // in der Luft: diese Regel hier erlaubt dem Chef write, und in
      // Firestore genuegt EINE zutreffende Regel, die erlaubt. Der
      // Regeltest hat genau das gefunden - dieselbe Falle wie beim
      // Firmencode, in derselben Datei, ein zweites Mal.
      allow write: if isChef() && doc != 'studios';
    }

    // ── Direktnachrichten (1:1) – nur die beiden Beteiligten ──
    // dmId hat die Form  dm_<uidA>_<uidB>
    match /dms/{dmId} {
      // Lesen/Abfragen über das participants-Feld (funktioniert auch für Listen-Abfragen)
      allow read: if istAktiv() && request.auth.uid in resource.data.participants;
      allow create: if istAktiv() && request.auth.uid in request.resource.data.participants;
      allow update: if istAktiv() && request.auth.uid in resource.data.participants;
    }
    match /dms/{dmId}/messages/{msgId} {
      allow read: if istAktiv() && dmId.split('_').hasAny([request.auth.uid]);
      allow create: if istAktiv()
        && request.resource.data.uid == request.auth.uid
        && dmId.split('_').hasAny([request.auth.uid])
        && audioOk();
      // Update nur für Beteiligte (z. B. Checklisten-Häkchen)
      allow update: if istAktiv() && dmId.split('_').hasAny([request.auth.uid]);
      allow delete: if istAktiv() && dmId.split('_').hasAny([request.auth.uid])
        && (isChef()
            || (resource.data.uid == request.auth.uid
                && request.time.toMillis() < resource.data.ts + 3600000));
    }

    // ── Marketing-App (marketing.html): Kampagnen-Projekte mit Versionen ──
    // Jeder Eingeloggte darf lesen und Projekte anlegen/pflegen.
    // Löschen: nur Chef oder wer das Projekt bzw. die Version angelegt hat.
    match /mkProjects/{projectId} {
      allow read: if istAktiv();
      allow create: if istAktiv()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if istAktiv();
      allow delete: if isChef()
        || (istAktiv() && resource.data.createdBy == request.auth.uid);

      match /versions/{versionId} {
        allow read: if istAktiv();
        allow create: if istAktiv()
          && request.resource.data.createdBy == request.auth.uid;
        // Versionen sind unveränderlich (Historie bleibt echt)
        allow update: if false;
        allow delete: if isChef()
          || (istAktiv() && resource.data.createdBy == request.auth.uid);
      }
    }

    // ── Wachstum & Betrieb (wachstum.html) ──

    // Termine: jeder Eingeloggte darf lesen/anlegen/pflegen (gleiches Muster
    // wie Aufgaben; die Studio-Zuordnung filtert die App). Löschen: Chef
    // oder wer den Termin angelegt hat.
    /* Termine enthalten KUNDENNAMEN, und jeder aktive Mitarbeiter darf
       sie lesen und aendern. Im Sicherheits-Durchlauf am 12.8.2026
       vorgelegt, vom Betreiber bewusst so entschieden: im Studio machen
       alle Termine, eine Einschraenkung auf den Ersteller waere eine
       Huerde ohne Nutzen.

       Bleibt richtig, solange das gilt. Wer das aendert — etwa weil ein
       Kunde nur die Leitung an Kundendaten lassen will — engt hier ein,
       nicht in der Oberflaeche. Erinnerung: personenbezogene Daten
       Dritter, nicht nur Betriebsdaten. */
    match /appointments/{apptId} {
      allow read: if istAktiv();
      allow create: if istAktiv()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() <= 200
        && request.resource.data.startsAt is number;
      allow update: if istAktiv();
      allow delete: if isChef()
        || (istAktiv() && resource.data.createdBy == request.auth.uid);
    }

    // E-Mail-Vorlagen (Bestätigung/Erinnerung/Follow-up/Storno):
    // nur der Chef pflegt sie; die Server-Funktion liest per Admin-Rechten.
    match /emailTemplates/{tplId} {
      allow read, write: if isChef();
    }

    // Kennzahlen je Studio (Mitglieder, Auslastung, Miete …): nur Chef.
    match /studioMetrics/{studioKey} {
      allow read, write: if isChef();
    }

    // Wettbewerbsbeobachtung: nur Chef.
    match /competitors/{compId} {
      allow read, write: if isChef();
    }

    // Expansionsplanung (mögliche neue Standorte): nur Chef.
    match /expansionLeads/{leadId} {
      allow read, write: if isChef();
    }

    // ── Schichtplan pro Studio ──
    match /studios/{studioKey}/shifts/{shiftId} {
      allow read: if istAktiv();
      // Einteilen darf nur die Verwaltung (Chef bzw. zuständiger Leiter)
      allow create, delete: if manages(studioKey);
      // Beim Tausch dürfen Mitarbeiter mitwirken – aber ausschliesslich an
      // den Tausch-Feldern. WER eingeteilt ist (uid, name), ändert nur die
      // Verwaltung beim Bestätigen. Sonst könnte sich jemand selbst aus dem
      // Plan schreiben oder einen anderen hineinsetzen.
      allow update: if manages(studioKey)
        // 1. Die eigene Schicht ausschreiben oder wieder zurückziehen
        || (istAktiv()
            && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['tausch','tauschVon','tauschTs']))
        // 2. Eine ausgeschriebene Schicht übernehmen – nur für sich selbst
        || (istAktiv()
            && resource.data.get('tausch', '') == 'offen'
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['tausch','tauschNeu','tauschTs'])
            && request.resource.data.tausch == 'zugesagt'
            && request.resource.data.tauschNeu.uid == request.auth.uid);
    }

    // ── Abwesenheiten (Urlaub / Krank / Frei) ──
    match /studios/{studioKey}/absences/{absId} {
      allow read: if istAktiv();
      // Jeder meldet sich selbst; die Verwaltung darf auch für andere eintragen
      allow create: if istAktiv()
        && (request.resource.data.uid == request.auth.uid || manages(studioKey))
        // Wer für sich selbst einträgt, darf sich nicht gleich selbst
        // genehmigen. Krankmeldungen und Einträge der Verwaltung schon.
        && (manages(studioKey)
            || request.resource.data.type == 'krank'
            || request.resource.data.status == 'offen');
      // Genehmigen und Ablehnen ist Sache der Verwaltung
      allow update: if manages(studioKey);
      allow delete: if manages(studioKey)
        || (istAktiv() && resource.data.uid == request.auth.uid);
    }

    // ── Übergabe-Notizen zwischen Schichten ──
    match /studios/{studioKey}/handovers/{hoId} {
      allow read: if istAktiv();
      allow create: if istAktiv() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if manages(studioKey)
        || (istAktiv() && resource.data.uid == request.auth.uid);
    }

    // ── Schwarzes Brett (für alle Studios gemeinsam) ──
    match /board/{postId} {
      allow read: if istAktiv();
      allow create: if istAktiv() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isChef()
        || (istAktiv() && resource.data.uid == request.auth.uid);
    }

    // ── Papierkorb ──
    // Gelöschtes liegt hier 30 Tage. Hineinlegen darf jeder Eingeloggte –
    // wer den Eintrag löschen durfte, darf ihn auch sichern. Ansehen,
    // zurückholen und endgültig entfernen ist Sache der Verwaltung.
    // Der Studio-Leiter sieht nur Einträge aus seinen Studios; Einträge
    // ohne Studio-Bezug (Infos, Dokumente, Brett) bleiben Chef-Sache.
    match /trash/{trashId} {
      allow read: if isChef()
        || (isLeiter() && resource.data.sk != null && manages(resource.data.sk));
      allow create: if istAktiv()
        && request.resource.data.deletedByUid == request.auth.uid;
      allow update: if false;                    // Papierkorb wird nicht bearbeitet
      allow delete: if isChef()
        || (isLeiter() && resource.data.sk != null && manages(resource.data.sk));
    }

    // ── Wochen-Sicherungen (Material + Putzplan als Excel) – nur Chef ──
    match /archives/{weekId} {
      allow read, write: if isChef();
    }

    /* ── Fehlerberichte ───────────────────────────────────────────────
       Wenn bei einem Mitarbeiter etwas nicht laedt, erfaehrt es heute
       niemand. Er sagt es vielleicht — vielleicht auch nicht, und bei
       einem Zugang je Studio weiss hinterher ohnehin keiner mehr, wer
       davorstand.

       SCHREIBEN darf jeder Angemeldete: sonst wuerde ausgerechnet der
       Fehler nicht gemeldet, der einen Mitarbeiter trifft.
       LESEN darf nur der Chef. In einer Fehlermeldung steht, wer sie
       ausgeloest hat und was er gerade tat — das ist nichts, was das
       ganze Team ueber jeden einsehen soll.

       update ist noetig, weil derselbe Fehler auf EINEM Dokument
       mitgezaehlt wird. Ohne das entstuenden aus einem kaputten
       Bildschirm hunderte Eintraege, und die Liste waere unlesbar. */
    match /fehler/{sig} {
      allow read, delete: if isChef();
      allow create, update: if istAktiv()
        && request.resource.data.text is string
        && request.resource.data.text.size() < 400;
    }

    // ── Push-Tokens (für Benachrichtigungen) ──
    // Die Server-Funktion liest sie per Admin-Rechten; Clients schreiben nur ihren eigenen.
    match /pushTokens/{token} {
      allow read: if false;
      allow create, update: if istAktiv()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if istAktiv() && resource.data.uid == request.auth.uid;
    }

    // ══════════════════════════════════════════════════════════════
    //  DIESELBEN REGELN, ABER JE FIRMA
    //  Maschinell aus dem flachen Satz oben erzeugt: jedes allow hat
    //  ein inFirma(f) davor. Die beiden Ausnahmen sind Absicht und
    //  stehen unten am jeweiligen Block.
    // ══════════════════════════════════════════════════════════════
    // ── Papierkorb für gelöschte Firmen ──
    // Eine gelöschte Firma verschwindet aus /firmen und liegt hier.
    // Ihre DATEN bleiben unter firmen/<kennung>/… liegen (das
    // Elterndokument fehlt dann, .get() sieht sie nicht mehr) — genau
    // wie beim Umzug: erst weg, wenn es jemand ausdrücklich wegräumt.
    //
    // Anders als /firmen ist das hier NICHT öffentlich lesbar. Der
    // Anmeldebildschirm braucht den Namen einer laufenden Firma; wer
    // gekündigt hat, geht niemanden mehr etwas an.
    match /firmenArchiv/{f} {
      allow read, write: if istAdminKonto();
    }

    match /firmen/{f} {
      // Die Stammdaten der Firma. Der Name steht auf dem
      // Anmeldebildschirm, also vor jeder Anmeldung lesbar.
      allow read: if true;

      /* ── Der Abo-Zustand (Stufe A aus ABO-PLAN.md) ──
         Liegt bewusst NICHT im Firmen-Dokument, obwohl das bequemer
         waere: das ist oeffentlich lesbar, weil der Anmeldebildschirm
         den Firmennamen braucht. Was ein Kunde zahlt, geht aber
         niemanden etwas an — am wenigsten einen Wettbewerber, der die
         Kennung errät.

         Lesen darf ihn der Betreiber und der Chef der eigenen Firma —
         wer zahlt, darf sehen, wofuer. Schreiben nur der Betreiber.

         Stufe A sperrt noch nichts. Wenn spaeter der Zustand
         'nurlesen' dazukommt, gehoert die Pruefung in JEDES allow der
         Firma — nicht in die App. Beim Sperren war dieser Fehler zwei
         Tage lang unbemerkt, und die Oberflaeche behauptete derweil das
         Gegenteil. */
      match /abo/{doc} {
        allow read: if istAdminKonto() || (inFirma(f) && isChef());
        allow write: if istAdminKonto();
      }
      // Angelegt und gesperrt wird eine Firma nur vom Betreiber.
      // istAdminKonto() prüft das FELD admin, nicht die Rolle — hier
      // stand noch die alte Fassung, und der Regeltest hat es gefunden.
      allow write: if istAdminKonto();

        match /config/registrierung {
          allow read, write: if inFirma(f) && (isChef());
        }

        match /config/beitrittSchalter {
          allow read: if true;
          allow write: if inFirma(f) && (isChef());
        }

        match /config/studios {
          allow read: if true;
          allow create: if inFirma(f) && (isChef());
          allow update: if inFirma(f) && (isChef()
            && request.resource.data.liste.size() >= resource.data.liste.size());
          allow delete: if false;
        }

        // ── Impressum und Datenschutz dieser Firma ──
        // Erklaerung siehe beim flachen /config/recht weiter oben. Hier
        // kommt die Firmengrenze dazu, und die ist der eigentliche Punkt:
        //
        //   read   OHNE Anmeldung. Ein Impressum hinter einem Login ist
        //          keins, und ein Kunde, der seinen Link herumgibt, muss
        //          sein Impressum zeigen koennen - genau dafuer steht die
        //          Firmenkennung im Link. Der Inhalt ist per Definition
        //          oeffentlich: Name, Anschrift, Vertretung, Telefon,
        //          E-Mail. Dieselbe Ueberlegung wie bei config/studios.
        //   write  ohne inFirma(f) duerfte der Chef von A das Impressum
        //          von B UEBERSCHREIBEN. Das ist kein Schoenheitsfehler:
        //          es steht dann fremde Haftung in der App eines anderen.
        //          Genau diese Sorte fehlender Firmenpruefung ist hier
        //          schon dreimal passiert.
        //
        // Gegenueber der allgemeinen Regel /firmen/{f}/config/{doc}
        // (read: inFirma(f) && istAktiv(), write: inFirma(f) && isChef())
        // weitet diese Regel nur das LESEN. Beim Schreiben ist sie
        // deckungsgleich, kann dort also weder oeffnen noch sperren.
        match /config/recht {
          allow read: if true;
          allow write: if inFirma(f) && isChef();
        }

        match /channels/{channelId}/messages/{msgId} {
          allow read: if inFirma(f) && (istAktiv());
          // Nur als man selbst senden; Bilder/Text/Aufnahme begrenzen
          allow create: if inFirma(f) && (istAktiv()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 2000
            && audioOk());
          // Reagieren darf jeder (nur das Feld reactions).
          // Den Text bearbeiten darf nur der Verfasser, und nur 15 Minuten lang.
          allow update: if inFirma(f) && (istAktiv() && (
               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            // Bei einer Umfrage abstimmen darf jeder – aber wirklich nur das
            // Stimmenfeld anfassen, nicht Frage oder Antworten.
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
            || (resource.data.uid == request.auth.uid
                && request.time.toMillis() < resource.data.ts + 900000
                && request.resource.data.diff(resource.data)
                     .affectedKeys().hasOnly(['text','editedAt','mentions']))
            // Anheften ist Sache der Verwaltung: was oben steht, sehen alle
            || (manages(channelId)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned']))
          ));
          // Chef darf jede Nachricht löschen; Mitarbeiter nur eigene innerhalb 1 Stunde
          allow delete: if inFirma(f) && (isChef()
            || manages(channelId)
            || (istAktiv()
                && resource.data.uid == request.auth.uid
                && request.time.toMillis() < resource.data.ts + 3600000));
        }

        match /studios/{studioKey}/todos/{todoId} {
          allow read: if inFirma(f) && (istAktiv());
          allow create: if inFirma(f) && (manages(studioKey));   // Chef überall, Leiter in seinen Studios
          allow delete: if inFirma(f) && (manages(studioKey));
          // Mitarbeiter dürfen abhaken / Foto anhängen (update erlaubt für Eingeloggte)
          allow update: if inFirma(f) && (istAktiv());
        }

        match /studios/{studioKey}/cleaning/{taskId} {
          allow read: if inFirma(f) && (istAktiv());
          allow create: if inFirma(f) && (manages(studioKey));   // Chef überall, Leiter in seinen Studios
          allow delete: if inFirma(f) && (manages(studioKey));
          allow update: if inFirma(f) && (istAktiv());                     // Mitarbeiter dürfen abhaken
        }

        match /studios/{studioKey}/cleaningNotes/{noteId} {
          allow read: if inFirma(f) && (istAktiv());
          allow create: if inFirma(f) && (istAktiv()
            && request.resource.data.byUid == request.auth.uid);
          // Chef darf jede Notiz löschen; Mitarbeiter nur eigene innerhalb 1 Stunde
          allow delete: if inFirma(f) && (manages(studioKey)
            || (istAktiv()
                && resource.data.byUid == request.auth.uid
                && request.time.toMillis() < resource.data.ts + 3600000));
          allow update: if false;
        }

        match /studios/{studioKey}/devices/{devId} {
          allow read: if inFirma(f) && (istAktiv());
          allow create: if inFirma(f) && (manages(studioKey)
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 80);
          allow delete: if inFirma(f) && (manages(studioKey));
          // Umbenennen und umziehen darf nur die Verwaltung. Alle anderen
          // dürfen ausschliesslich den Zustand melden – sonst könnte eine
          // Meldung nebenbei das Gerät umbenennen.
          allow update: if inFirma(f) && (manages(studioKey)
            || (istAktiv()
                && request.resource.data.diff(resource.data)
                     .affectedKeys().hasOnly(['status','lastNote','lastBy','lastAt'])));
        }

        match /studios/{studioKey}/deviceLog/{logId} {
          allow read: if inFirma(f) && (istAktiv());
          allow create: if inFirma(f) && (istAktiv()
            && request.resource.data.byUid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 300
            && devPhotoOk());
          allow update: if false;
          allow delete: if inFirma(f) && (manages(studioKey));
        }

        match /announcements/{annId} {
          allow read: if inFirma(f) && (istAktiv());
          // Chef an alle oder einzelne Studios; Leiter nur an seine Studios
          allow create: if inFirma(f) && (request.resource.data.uid == request.auth.uid
            && (isChef()
                || (isLeiter() && request.resource.data.target in myKeys())));
          // Chef/zuständiger Leiter dürfen alles; alle anderen nur das Lesen markieren
          allow update: if inFirma(f) && (isChef()
            || (isLeiter() && resource.data.target in myKeys())
            || (istAktiv() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])));
          allow delete: if inFirma(f) && (isChef()
            || (isLeiter() && resource.data.target in myKeys()));
        }

        match /inventory/{studioKey} {
          allow read: if inFirma(f) && (istAktiv());
          // Eintragen dürfen alle Eingeloggten; das Soll-Limit setzt die Verwaltung
          allow write: if inFirma(f) && (istAktiv());
        }

        match /documents/{docId} {
          allow read: if inFirma(f) && (istAktiv());
          // Leiter darf nur Dokumente anlegen, die ausschließlich seine Studios betreffen
          allow create: if inFirma(f) && (isChef()
            || (isLeiter() && request.resource.data.studios.hasOnly(myKeys())));
          allow update, delete: if inFirma(f) && (isChef()
            || (isLeiter() && resource.data.studios.hasOnly(myKeys())));
        }

        match /documentData/{docId} {
          allow read: if inFirma(f) && (istAktiv());
          allow create, update: if inFirma(f) && (isChef()
            || (isLeiter()
                && exists(/databases/$(database)/documents/documents/$(docId))
                && get(/databases/$(database)/documents/documents/$(docId))
                     .data.studios.hasOnly(myKeys())));
          allow delete: if inFirma(f) && (isChef());
        }

        /* ── Nachweise: der eine Riegel, der wirklich einer ist ──
           Stufe B aus ABO-PLAN.md. Certificates sind eine eigene
           Sammlung, deshalb laesst sich die Stufe hier durchsetzen.

           Bei der Auswertung geht das NICHT: die rechnet aus Aufgaben,
           Putzplan und Material — Daten, die das Team ohnehin sieht.
           Dort ist Premium eine Bequemlichkeit, kein Schloss. Das steht
           so auch in ABO-PLAN.md, damit es niemand anders verkauft.

           Lesen bleibt fuer alle Stufen offen: wer schon Nachweise
           hinterlegt hat und auf Basic wechselt, soll sie noch sehen
           und herausholen koennen. Weggenommen wird das ANLEGEN. Eine
           Funktion, die vorhandene Daten unerreichbar macht, ist keine
           Preisstufe, sondern ein Verlust. */
        // Begruendung siehe beim flachen /certificates weiter oben.
        // Hier kommt die Firmengrenze dazu und die Abo-Stufe: Nachweise
        // sind Premium, und das gilt fuer die Selbsteintragung genauso —
        // sonst waere die Stufe ueber einen Umweg ausgehebelt.
        match /certificates/{certId} {
          allow read: if inFirma(f) && (isChef()
            || (istAktiv() && resource.data.uid == request.auth.uid));
          allow create: if inFirma(f) && hatPremium(f)
            && (isChef()
                || (istAktiv()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.erfasstVonUid == request.auth.uid
                    && request.resource.data.get('bestaetigt', false) == false));
          // Nach der Bestaetigung nur noch der Chef — siehe oben.
          allow update: if inFirma(f) && hatPremium(f)
            && (isChef()
                || (istAktiv()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && resource.data.get('bestaetigt', false) == false
                    && request.resource.data.get('bestaetigt', false) == false));
          allow delete: if inFirma(f) && isChef() && hatPremium(f);
        }

        match /config/{doc} {
          // registrierung ist ausdruecklich ausgenommen: In Firestore gilt
          // JEDE zutreffende Regel, nicht die speziellste. Ohne diese
          // Ausnahme wuerde die allgemeine Regel hier den Firmencode fuer
          // jeden Eingeloggten lesbar machen - und die Sperre waere
          // Dekoration.
          allow read: if inFirma(f) && (istAktiv() && doc != 'registrierung'
                       && doc != 'beitrittSchalter' && doc != 'studios');
          // 'studios' muss auch beim SCHREIBEN ausgenommen sein, nicht nur
          // beim Lesen. Sonst haengt die Sperre "die Liste darf nur wachsen"
          // in der Luft: diese Regel hier erlaubt dem Chef write, und in
          // Firestore genuegt EINE zutreffende Regel, die erlaubt. Der
          // Regeltest hat genau das gefunden - dieselbe Falle wie beim
          // Firmencode, in derselben Datei, ein zweites Mal.
          allow write: if inFirma(f) && (isChef() && doc != 'studios');
        }

        match /dms/{dmId} {
          // Lesen/Abfragen über das participants-Feld (funktioniert auch für Listen-Abfragen)
          allow read: if inFirma(f) && (istAktiv() && request.auth.uid in resource.data.participants);
          allow create: if inFirma(f) && (istAktiv() && request.auth.uid in request.resource.data.participants);
          allow update: if inFirma(f) && (istAktiv() && request.auth.uid in resource.data.participants);
        }

        match /dms/{dmId}/messages/{msgId} {
          allow read: if inFirma(f) && (istAktiv() && dmId.split('_').hasAny([request.auth.uid]));
          allow create: if inFirma(f) && (istAktiv()
            && request.resource.data.uid == request.auth.uid
            && dmId.split('_').hasAny([request.auth.uid])
            && audioOk());
          // Update nur für Beteiligte (z. B. Checklisten-Häkchen)
          allow update: if inFirma(f) && (istAktiv() && dmId.split('_').hasAny([request.auth.uid]));
          allow delete: if inFirma(f) && (istAktiv() && dmId.split('_').hasAny([request.auth.uid])
            && (isChef()
                || (resource.data.uid == request.auth.uid
                    && request.time.toMillis() < resource.data.ts + 3600000)));
        }

        match /mkProjects/{projectId} {
          allow read: if inFirma(f) && (istAktiv());
          allow create: if inFirma(f) && (istAktiv()
            && request.resource.data.createdBy == request.auth.uid);
          allow update: if inFirma(f) && (istAktiv());
          allow delete: if inFirma(f) && (isChef()
            || (istAktiv() && resource.data.createdBy == request.auth.uid));

          match /versions/{versionId} {
            allow read: if inFirma(f) && (istAktiv());
            allow create: if inFirma(f) && (istAktiv()
              && request.resource.data.createdBy == request.auth.uid);
            // Versionen sind unveränderlich (Historie bleibt echt)
            allow update: if false;
            allow delete: if inFirma(f) && (isChef()
              || (istAktiv() && resource.data.createdBy == request.auth.uid));
          }
        }

        match /appointments/{apptId} {
          allow read: if inFirma(f) && (istAktiv());
          allow create: if inFirma(f) && (istAktiv()
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.customerName is string
            && request.resource.data.customerName.size() <= 200
            && request.resource.data.startsAt is number);
          allow update: if inFirma(f) && (istAktiv());
          allow delete: if inFirma(f) && (isChef()
            || (istAktiv() && resource.data.createdBy == request.auth.uid));
        }

        match /emailTemplates/{tplId} {
          allow read, write: if inFirma(f) && (isChef());
        }

        match /studioMetrics/{studioKey} {
          allow read, write: if inFirma(f) && (isChef());
        }

        match /competitors/{compId} {
          allow read, write: if inFirma(f) && (isChef());
        }

        match /expansionLeads/{leadId} {
          allow read, write: if inFirma(f) && (isChef());
        }

        match /studios/{studioKey}/shifts/{shiftId} {
          allow read: if inFirma(f) && (istAktiv());
          // Einteilen darf nur die Verwaltung (Chef bzw. zuständiger Leiter)
          allow create, delete: if inFirma(f) && (manages(studioKey));
          // Beim Tausch dürfen Mitarbeiter mitwirken – aber ausschliesslich an
          // den Tausch-Feldern. WER eingeteilt ist (uid, name), ändert nur die
          // Verwaltung beim Bestätigen. Sonst könnte sich jemand selbst aus dem
          // Plan schreiben oder einen anderen hineinsetzen.
          allow update: if inFirma(f) && (manages(studioKey)
            // 1. Die eigene Schicht ausschreiben oder wieder zurückziehen
            || (istAktiv()
                && resource.data.uid == request.auth.uid
                && request.resource.data.diff(resource.data)
                     .affectedKeys().hasOnly(['tausch','tauschVon','tauschTs']))
            // 2. Eine ausgeschriebene Schicht übernehmen – nur für sich selbst
            || (istAktiv()
                && resource.data.get('tausch', '') == 'offen'
                && request.resource.data.diff(resource.data)
                     .affectedKeys().hasOnly(['tausch','tauschNeu','tauschTs'])
                && request.resource.data.tausch == 'zugesagt'
                && request.resource.data.tauschNeu.uid == request.auth.uid));
        }

        match /studios/{studioKey}/absences/{absId} {
          allow read: if inFirma(f) && (istAktiv());
          // Jeder meldet sich selbst; die Verwaltung darf auch für andere eintragen
          allow create: if inFirma(f) && (istAktiv()
            && (request.resource.data.uid == request.auth.uid || manages(studioKey))
            // Wer für sich selbst einträgt, darf sich nicht gleich selbst
            // genehmigen. Krankmeldungen und Einträge der Verwaltung schon.
            && (manages(studioKey)
                || request.resource.data.type == 'krank'
                || request.resource.data.status == 'offen'));
          // Genehmigen und Ablehnen ist Sache der Verwaltung
          allow update: if inFirma(f) && (manages(studioKey));
          allow delete: if inFirma(f) && (manages(studioKey)
            || (istAktiv() && resource.data.uid == request.auth.uid));
        }

        match /studios/{studioKey}/handovers/{hoId} {
          allow read: if inFirma(f) && (istAktiv());
          allow create: if inFirma(f) && (istAktiv() && request.resource.data.uid == request.auth.uid);
          allow update: if false;
          allow delete: if inFirma(f) && (manages(studioKey)
            || (istAktiv() && resource.data.uid == request.auth.uid));
        }

        match /board/{postId} {
          allow read: if inFirma(f) && (istAktiv());
          allow create: if inFirma(f) && (istAktiv() && request.resource.data.uid == request.auth.uid);
          allow update: if false;
          allow delete: if inFirma(f) && (isChef()
            || (istAktiv() && resource.data.uid == request.auth.uid));
        }

        match /trash/{trashId} {
          allow read: if inFirma(f) && (isChef()
            || (isLeiter() && resource.data.sk != null && manages(resource.data.sk)));
          allow create: if inFirma(f) && (istAktiv()
            && request.resource.data.deletedByUid == request.auth.uid);
          allow update: if false;                    // Papierkorb wird nicht bearbeitet
          allow delete: if inFirma(f) && (isChef()
            || (isLeiter() && resource.data.sk != null && manages(resource.data.sk)));
        }

        match /archives/{weekId} {
          allow read, write: if inFirma(f) && (isChef());
        }

        // Siehe oben: schreiben darf jeder Angemeldete, lesen nur der Chef.
        match /fehler/{sig} {
          allow read, delete: if inFirma(f) && (isChef());
          allow create, update: if inFirma(f) && istAktiv()
            && request.resource.data.text is string
            && request.resource.data.text.size() < 400;
        }

        match /pushTokens/{token} {
          allow read: if false;
          allow create, update: if inFirma(f) && (istAktiv()
            && request.resource.data.uid == request.auth.uid);
          allow delete: if inFirma(f) && (istAktiv() && resource.data.uid == request.auth.uid);
        }
    }

  }
}
